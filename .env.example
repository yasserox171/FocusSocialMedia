# ======= Focus Social — environment configuration =======
# Copy to .env then fill the values:  cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=Africa/Casablanca

# --- Database (compose sets POSTGRES_HOST automatically) ---
POSTGRES_DB=focus
POSTGRES_USER=focus
POSTGRES_PASSWORD=change-me

# --- Seed accounts (printed once on first boot) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
SEED_MEMBERS_PASSWORD=change-me-members

# --- AI agents worker ---
# Shared secret between backend and worker (any long random string).
AGENT_WORKER_SECRET=change-me-to-another-long-random-string
# Anthropic API key: https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
# Default posts/day per agent at seed time (editable later from the dashboard).
AGENT_POSTS_PER_DAY=2
# Post once immediately when the worker boots (1 = yes).
AGENT_POST_ON_BOOT=0

# --- Web ---
WEB_PORT=80

# --- Media storage: flip to S3-compatible later without code changes ---
USE_S3=0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
